{
  "name": "coworking-mobile",
  "version": "2026.6.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "android": "npm run start -- --android",
    "build:android": "rm -f build*.apk && SENTRY_DISABLE_AUTO_UPLOAD=true eas build --profile preview --platform android --local && npm run install:android",
    "build:ios": "rm -f build*.ipa && SENTRY_DISABLE_AUTO_UPLOAD=true eas build --non-interactive --profile preview --platform ios --local && npm run install:ios",
    "check": "DEBUG=eslint:cli-engine eslint --ext .ts,.js,.tsx src",
    "clean": "rm -rf .expo node_modules ios android && npm i && npm run prebuild",
    "deploy": "eas build --platform all --non-interactive --auto-submit-with-profile=production",
    "dev": "npm run prebuild && expo run --port 19001",
    "dev:android": "expo run:android --port 19001",
    "dev:ios": "expo run:ios --port 19001",
    "eas": "eas",
    "expo:update": "npx expo install --check",
    "install:android": "adb install build-*.apk",
    "install:ios": "xcrun devicectl device install app build*.ipa",
    "ios": "npm run start -- --ios",
    "postinstall": "patch-package",
    "prebuild": "expo prebuild --clean",
    "start": "expo start --port 19001",
    "update": "ncu --deep --cooldown 7d",
    "update:interactive": "npm run update -- --interactive"
  },
