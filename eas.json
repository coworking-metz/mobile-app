{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "channel": "staging",
      "distribution": "internal",
      "env": {
        "APP_NAME": "Le Poulailler (dev)"
      }
    },
    "production": {
      "env": {
        "EAS_USE_CACHE": "1",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "armeabi-v7a,arm64-v8a"
      },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 3.16.0"
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "UCLTV6L95C",
        "ascAppId": "6463384267"
      }
    }
  }
}
